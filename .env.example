# Kie.ai (gateway ke model AI, chatbot HistoAI). Ambil di kie.ai dashboard.
KIE_AI_API_KEY=
# Opsional: override model tanpa ubah kode. Default: deepseek-v4-1-flash.
# Kalau Kie error model-not-found, ganti ke model yang aktif di akunmu.
KIE_MODEL=deepseek-v4-1-flash

# Upstash Redis REST (rate-limit endpoint AI). Ambil dari dashboard Upstash > REST API.
# Opsional: kalau kosong, rate-limit otomatis dinonaktifkan (mode dev).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry error tracking (lihat error AR di HP siswa). Buat project "Browser/React"
# di sentry.io > Settings > Client Keys (DSN). Aman diekspos ke client.
# Opsional: kalau kosong, monitoring otomatis nonaktif (no-op).
VITE_SENTRY_DSN=

# Supabase Postgres (database penelitian: siswa, quiz, chat). WAJIB untuk
# pencatatan data. Ambil di dashboard Supabase > Settings > API.
# PENTING: pakai service_role secret (server-only, bypass RLS). Jangan pernah
# pakai prefix VITE_ dan jangan commit value asli (isi di .env.local / Vercel).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Password export CSV penelitian (halaman /rekap, tidak ada di nav).
# Buat string acak yang kuat, isi di .env.local / Vercel. Jangan commit value asli.
EXPORT_PASSWORD=
